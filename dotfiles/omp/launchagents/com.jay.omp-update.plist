<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jay.omp-update</string>

    <!-- No absolute paths: launchd sets HOME, so the file works for any user. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>export PATH="$HOME/.local/bin:/usr/bin:/bin"; echo "$(date '+%F %T') $(omp update 2>&amp;1 | tr '\n' ' ')" &gt;&gt; "$HOME/Library/Logs/omp-update.log"</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
</dict>
</plist>
